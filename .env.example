# ---- Server-side only (NOT exposed to the browser; no VITE_ prefix) ----

# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Supabase "service_role" key (Project Settings -> API -> service_role).
# This key bypasses Row Level Security, which is exactly why it must only
# ever live here, in a serverless function env var, and never in frontend
# code or a VITE_-prefixed variable.
SUPABASE_SERVICE_ROLE_KEY=

# The passcode the app will ask for once and then remember in the browser.
# Make this a long, random string, not a short PIN -- anyone with it has
# full read/write access to all your data. Generate one with:
#   openssl rand -hex 24
APP_ACCESS_TOKEN=
